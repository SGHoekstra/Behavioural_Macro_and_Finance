.DS_Store

# CondaPkg.jl build cache — regenerated from pluto_tutorial/CondaPkg.toml.
# Contains machine-specific absolute paths and an os/arch-pinned lockfile.
.CondaPkg/

# Stale duplicate of the notebooks (macOS "Compress" artifact).
Archive.zip

# Generated by PlutoPages/sync_content.jl — pluto_tutorial/ is the source of truth
content/notebooks/
content/assets/lectures/

# PlutoPages build output
PlutoPages/_site/
PlutoPages/_cache/
generation_report.html

# TensorBoard logs written by sbi when notebook 08 trains; the filenames
# embed the machine's hostname.
sbi-logs/

# Handout builds: keep the PDFs, not the LaTeX intermediates
*-handout.aux
*-handout.log
*-handout.nav
*-handout.out
*-handout.snm
*-handout.toc
*-handout.bbl
*-handout.blg
*-handout.fls
*-handout.fdb_latexmk
